@page
@model DeafRegisterModel

@{
    ViewData["Title"] = "Register";
}

<body onload="loadRegisterPage()">
<h1>@ViewData["Title"]</h1>

<form asp-route-returnUrl="@Model.ReturnUrl" method="post" id="registerForm">
    <hr />


    <div asp-validation-summary="All" class="text-danger">
                    <h2>Register Errors:</h2>
                </div>

    <input hidden value="8" asp-for="Input.etiologyId" />
  
    <div class="form-row">
                <div class="form-group col-md-3">
                    <label asp-for="Input.CurrentAge"><span style="color:red">*</span>How old are you?</label>
                    <select id="age" asp-for="Input.CurrentAge" asp-items="@Model.ageList">
                        <option value="" selected>Please Select</option>
                    </select>
                    <br>   <span asp-validation-for="Input.CurrentAge" class="text-danger"></span>
                </div>
    </div>
        <div class="form-row">
            <div class="form-group col-md-4">
                <label asp-for="Input.DiagnosisAge"><span style="color:red">*</span>Age of onset of hearing loss</label>
                <select id="age" asp-for="Input.DiagnosisAge" asp-items="@Model.ageList">
                    <option value="" selected>Please Select</option>
                </select><br />
                <span asp-validation-for="Input.DiagnosisAge" class="text-danger"></span>
            </div>
        </div><br />
        <div class="form-row">
            <span style="color:red">*</span>
            <div class="form-group col-md-6">
                <div class="form-group">
                    <label for="Input_state">What country do you currently live in?<br /></label>
                    <select id="selectCountry" asp-for="Input.Country" asp-items="@Model.countryList" data-dropup-auto="false" onchange="checkCountry()">
                    </select>
                    <br /><span asp-validation-for="Input.Country" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-4" id="stateDiv">
                <div class="form-group">
                    <label for="Input_state"><span style="color:red">*</span> What state do you live in?<br /></label>
                    <select id="stateSelect" asp-for="Input.state" asp-items="@Model.stateList" data-dropup-auto="false">
                        <option value="" selected>Please Select</option>
                    </select>
                    <br /><span asp-validation-for="Input.state" class="text-danger"></span>
                    <span id="stateError" class="text-danger"></span>
                </div>
            </div>
        </div>

    <div class="form-row">
        <div class="form-group col-md-3">
            <label asp-for="Input.firstName"><span style="color:red">*</span>First Name</label>
            <input  asp-for="Input.firstName" class="form-control" />
            <span asp-validation-for="Input.firstName" class="text-danger"></span>
        </div>
        <div class="form-group col-md-3">
            <label asp-for="Input.middleName">Middle Name</label>
            <input  asp-for="Input.middleName" class="form-control" />
            <span asp-validation-for="Input.middleName" class="text-danger"></span>
        </div>
        <div class="form-group col-md-3">
            <label asp-for="Input.lastName"><span style="color:red">*</span>Last Name</label>
            <input  asp-for="Input.lastName" class="form-control" />
            <span asp-validation-for="Input.lastName" class="text-danger"></span>
        </div>
            </div>
        <div class="form-row">
            <div class="form-group col-sm-4">
            <label asp-for="Input.phoneNumber"><span style="color:red">*</span>Phone Number</label>
            <input  asp-for="Input.phoneNumber" pattern="[0-9]+" placeholder="0123456789" class="form-control" />
            <span asp-validation-for="Input.phoneNumber" class="text-danger"></span>
        </div>
        </div>
    <div class="form-row">
        <div class="form-group col-sm-4">

            <label asp-for="Input.Email"><span style="color:red">*</span>Email</label>
            <input id="contributorEmail" asp-for="Input.Email" class="form-control" onkeyup="compareEmails()" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
    </div>
    <div class="form-row">
        <div class="form-group col-sm-4">

            <label asp-for="Input.ConfirmEmail"><span style="color:red">*</span>Confirm Email</label>
            <input id="compareEmail" asp-for="Input.ConfirmEmail" class="form-control" onkeyup="compareEmails()" />
            <span id="confirmEmailValidation" asp-validation-for="Input.ConfirmEmail" class="text-danger"></span>
        </div>

    </div>
    <div class="form-row">
              <div class="form-group col-sm-4">
            <br/>
            <details open>
                <summary>Password Requirements</summary>
                <ul>
                    <li>Passwords must have at least one non alphanumeric character.</li>
                    <li>Passwords must have at least one digit ('0'-'9').</li>
                    <li>Passwords must have at least one uppercase ('A'-'Z').</li>
                    <li>The Password must be at least 9 and at max 100 characters long.</li>
                </ul>
            </details></div>
    </div>
    <div class="form-row">
        <div class="form-group col-sm-4">
            <label asp-for="Input.Password"><span style="color:red">*</span>Password</label>
            <input id="password"  asp-for="Input.Password" class="form-control" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>
    </div>
    <div class="form-row">
        <div class="form-group col-sm-4">           
            <label asp-for="Input.ConfirmPassword"><span style="color:red">*</span>Confirm Password</label>
            <input id="confirmPassword" asp-for="Input.ConfirmPassword" class="form-control" />
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>
    </div>
        <div>
            <input type="checkbox" onclick="showHidePassword()"> Show Password          
        </div>
        <br />

        <div class="form-row">
        <div class="form-group col-md-10">
                <label asp-for="Input.ReferenceSource"><span style="color:red">*</span>Where did you hear about the Speech Accessibility Project study?</label>
            <input asp-for="Input.ReferenceSource" class="form-control" />
            <span asp-validation-for="Input.ReferenceSource" class="text-danger"></span>
        </div></div><br/>
        <div class="form-row">
            <div class="form-group col-md-10">
                <fieldset>
                    <legend><span style="color:red">*</span>Do you use a listening device in your left ear?</legend>
                    <label asp-for="Input.DeafScreening.LeftListeningDevice"><input type="radio" asp-for="Input.DeafScreening.LeftListeningDevice" value="Yes, I regularly use a cochlear implant in my left ear" />Yes, I regularly use a cochlear implant in my left ear</label>
                    <br />
                    <label asp-for="Input.DeafScreening.LeftListeningDevice"><input type="radio" asp-for="Input.DeafScreening.LeftListeningDevice" value="Yes, I regularly use a hearing aid in my left ear">Yes, I regularly use a hearing aid in my left ear</label>
                    <br />
                    <label asp-for="Input.DeafScreening.LeftListeningDevice"><input type="radio" asp-for="Input.DeafScreening.LeftListeningDevice" value="No, I previously used a cochlear implant or hearing aid in my left year but now I normally do not" />No, I previously used a cochlear implant or hearing aid in my left year but now I normally do not</label>
                    <br ○	No, I previously used a cochlear implant or hearing aid in my left year but now I normally do not
                    <label asp-for="Input.DeafScreening.LeftListeningDevice"><input type="radio" asp-for="Input.DeafScreening.LeftListeningDevice" value="No, I never used a cochlear implant or hearing aid" />No, I never used a cochlear implant or hearing aid</label>
                    <br />
                    <span asp-validation-for="Input.DeafScreening.LeftListeningDevice" class="text-danger"></span>
                </fieldset>
                </div></div><br />
        <div class="form-row">
            <div class="form-group col-md-10">
                <fieldset>
                    <legend><span style="color:red">*</span>Do you use a listening device in your right ear?</legend>
                    <label asp-for="Input.DeafScreening.RightListeningDevice"><input type="radio" asp-for="Input.DeafScreening.RightListeningDevice" value="Yes, I regularly use a cochlear implant in my right ear" />Yes, I regularly use a cochlear implant in my right ear</label>
                    <br />
                    <label asp-for="Input.DeafScreening.RightListeningDevice"><input type="radio" asp-for="Input.DeafScreening.RightListeningDevice" value="Yes, I regularly use a hearing aid in my right ear" />Yes, I regularly use a hearing aid in my right ear</label>
                    <br />
                    <label asp-for="Input.DeafScreening.RightListeningDevice"><input type="radio" asp-for="Input.DeafScreening.RightListeningDevice" value="No, I previously used a cochlear implant or hearing aid in my right year but now I normally do not" />No, I previously used a cochlear implant or hearing aid in my right year but now I normally do not</label>
                   <br />
                    <label asp-for="Input.DeafScreening.RightListeningDevice"><input type="radio" asp-for="Input.DeafScreening.RightListeningDevice" value="No, I never used a cochlear implant or hearing aid" />No, I never used a cochlear implant or hearing aid</label>
                    <br /><span asp-validation-for="Input.DeafScreening.RightListeningDevice" class="text-danger"></span>
                </fieldset>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group col-md-10">
                <fieldset>
                    <legend><span style="color:red">*</span>Which most closely matches your language use? </legend>
                    <div class="slidecontainer">
                        <label>speech</label>
                        <input type="range" min="0" max="100" value="50" class="slider" id="myRange">
                   <label>sign</label>
                    </div>
                    <span id="rangeOutput">50% speech/50% sign</span>
                    <input id="rangeValue" hidden asp-for="Input.DeafScreening.LanguageUse" value="50% speech /50% sign" />
                     <span asp-validation-for="Input.DeafScreening.LanguageUse" class="text-danger"></span>
                </fieldset>
            </div>
        </div>

    <button class="btn btn-primary" id="registerSubmit">Submit</button>

</form>
</body>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script>

    $(document).ready(function () {

        $("#registerForm").submit(function(){
            
            //disable the submit button
            $("#registerSubmit").attr("disabled", true);
            return true;
    });
    });

    function enableSubmit()
    {
            $("#registerSubmit").attr("disabled", false);
    }

    function updateRangeValue()
    {
            var slider = document.getElementById("myRange");
    var output = document.getElementById("rangeOutput");
    var signPercent = slider.value;
    var speechPercent = 100 - signPercent;
    var displayPercent = speechPercent +"% speech/ " + signPercent+"% sign"; 
    output.innerHTML = displayPercent;
    var rangeValue = document.getElementById("rangeValue");
    rangeValue.value=displayPercent;
    }

    const form = document.querySelector('form');
    form.addEventListener('change', function () {
        enableSubmit();
    });
    form.addEventListener('keyup', function () {
        enableSubmit();
    });
    form.addEventListener('change',function(){
        updateRangeValue();
    });

</script>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
